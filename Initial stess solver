s_t_b = - E_hot_int*a/(1-poisson) * (int_heat_flux*t/(2*k))       #compressive tangential thermal bending stress (given free avg expantion)
s_t_m = - E_hot_int*a/(1-poisson) * (int_avg_wall_temp-273.15)    #compressive tangential thermal membrain stress of avg wall temp
