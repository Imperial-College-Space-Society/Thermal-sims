def f_YS(T):
    if T > T_YS[-1]:
        return YS[-1] + -B_YS*A_YS*np.exp(-B_YS*T_YS[-1]) * (T-T_YS[-1])   #Linear extrapolation of YS from the last data point using the gradient of the exponenetial fit
    for i in range(len(YS)-1):
        if T_YS[i] <= T <= T_YS[i+1]:
            m = (YS[i+1]-YS[i])/(T_YS[i+1]-T_YS[i])
            return YS[i] + m*(T-T_YS[i])
        

