def arc_orientation(a):
    if a.dxf.start_angle < 180:
        return 'frown'
    elif a.dxf.start_angle >= 180:
        return 'smile'
        
        
def start_of_segment(a):
    
    if a.dxftype() == 'LINE':
        return a.dxf.start.x 
    
    elif a.dxftype() == 'ARC':
        if arc_orientation(a) == 'smile':
            return a.start_point[0]
        elif arc_orientation(a) == 'frown':
            return a.end_point[0]
    
    elif a.dxftype() == 'SPLINE':
        return a.control_points[0,0]
    
    
def end_of_segment(a):
    
    if a.dxftype() == 'LINE':
        return a.dxf.end.x 
    
    elif a.dxftype() == 'ARC':
        if arc_orientation(a) == 'smile':
            return a.end_point[0]
        elif arc_orientation(a) == 'frown':
            return a.start_point[0]
    
    elif a.dxftype() == 'SPLINE':
        return a.control_points[2,0]
    
    
def func(a, x):        #creates cartisian functions from model space values
    
    if a.dxftype() == 'LINE':
        x1, y1 = a.dxf.start.x, a.dxf.start.y
        x2, y2 = a.dxf.end.x, a.dxf.end.y
        m = (y2-y1)/(x2-x1)
        c = y1-m*x1
        return m*x+c
    
    elif a.dxftype() == 'ARC':
        x_c, y_c, r = a.dxf.center.x, a.dxf.center.y, a.dxf.radius
        if arc_orientation(a) == 'smile':
            return y_c - np.sqrt(r**2-(x-x_c)**2)
        elif arc_orientation(a) == 'frown':
            return y_c + np.sqrt(r**2-(x-x_c)**2)
    
    elif a.dxftype() == 'SPLINE':
        P_0x, P_0y = a.control_points[0,0], a.control_points[0,1]
        P_1x, P_1y = a.control_points[1,0], a.control_points[1,1]
        P_2x, P_2y = a.control_points[2,0], a.control_points[2,1]
        Ax, Ay = P_0x-2*P_1x+P_2x, P_0y-2*P_1y+P_2y
        Bx, By = 2*(P_1x-P_0x), 2*(P_1y-P_0y)
        Cx, Cy = P_0x, P_0y
        t = (-Bx+np.sqrt(Bx**2-4*Ax*(Cx-x)))/(2*Ax)
        return Ay*t**2+By*t+Cy

#actual chamber geometry function
def chamber_radius(msp, x):
    if start_of_segment(msp[0]) <= x <= end_of_segment(msp[-1]):          #defining the function's range (chamber length)
        for i in range(len(msp)-1):                         #all segments but the last which is a straight line at 0 all the way along the chamber lentgh
            if start_of_segment(msp[i]) <= x <= end_of_segment(msp[i]):
                return func(msp[i], x)
            else:
                continue 
    else:
        return 0 


