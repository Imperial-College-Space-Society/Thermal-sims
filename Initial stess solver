##Pressure drop calculator (using Darcy-Wiesbach only)
A = h_channels * avg_regen_widths - (4*fillet_radius**2 - np.pi*fillet_radius**2)  #individual channel area (m^2)
int_rho = f_rho(int_coolant_temp)    #array of coolant densities along the regen channels (N segments) (in kg/m^3), using the rho interpolation/extrapolation function and interpolated RPA coolant temps
