def fM(AR, M, gamma):
    return AR**2 - 1/M**2 * (2/(gamma+1) * (1 + (gamma-1)/2 * M**2))**((gamma+1)/(gamma-1))

def dfM(AR, M, gamma):
    g = 1 + (gamma-1)/2 * M**2
    n = (gamma+1)/(gamma-1)
    
    return -(2/(gamma+1))**n * M**(-3) * g**(n-1) * (n*(gamma-1)*M**2 - 2*g)


#vectorised Newton_raphson to find M_vals (written by Claude)
def solve_mach(AR, gamma_int, r_vals, tol=1e-10, max_iter=50):
    """
    Vectorized Newton-Raphson solve for M(x) given area ratio AR(x) and gamma(x).
    throat_index is taken as the index of minimum radius (M = 1 there).
    """
    
    M = np.empty(N)

    # --- branch masks ---
    sub_mask = np.arange(N) < throat_index    # converging section, M < 1
    sup_mask = np.arange(N) > throat_index     # diverging section, M > 1

    # --- initial guesses, branch-aware ---
    # subsonic: start modest and push down as AR grows
    M[sub_mask] = np.clip(1 / AR[sub_mask], 0.05, 0.9)
    # supersonic: start just above 1 and push up as AR grows
    M[sup_mask] = np.clip(1.0 + 0.5 * np.log(AR[sup_mask]), 1.05, None)

    # throat point(s) fixed exactly at 1
    M[throat_index] = 1.0

    # --- Newton iterations, vectorized over whole array at once ---
    for _ in range(max_iter):
        f  = fM(AR, M, gamma_int)
        df = dfM(AR, M, gamma_int)

        step = f / df
        M_new = M - step

        # keep each branch on its own side of M = 1 to avoid branch-jumping
        M_new[sub_mask] = np.clip(M_new[sub_mask], 1e-6, 0.999999)
        M_new[sup_mask] = np.clip(M_new[sup_mask], 1.000001, None)

        delta = np.max(np.abs(M_new[~ (np.arange(N) == throat_index)]
                               - M[~ (np.arange(N) == throat_index)]))

        M = M_new
        M[throat_index] = 1.0  # re-pin throat every iteration

        if delta < tol:
            break

    return M


# --- usage with your existing arrays ---
