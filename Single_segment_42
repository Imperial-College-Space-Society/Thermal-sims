#convective heat flux coeficents for segments adjacent to fluid (in temp change, to be put straight into A)
def dT_conv(A, m, h_spesific):
    dx = m/(rho*A)
    h_Eff = 1/(1/h_spesific + dx/(2*k))     #linear extrapolation correction for difference between surface and node temp 
    return A*h_Eff*dt/(m*c)

def dT_coolant(A, m):                 #convective heat flux coeficents for coolant  
    dx = m/(rho*A)    
    m_coolant = (h*w/2 - 1/2 * (4*r**2-np.pi*r**2))*dz*rho_c  
    h_Eff = 1/(1/h_c + dx/(2*k))               
    return A*h_Eff*dt/(m_coolant*c_c)


