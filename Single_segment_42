# Store polygons and corresponding temperatures
polygons = []
temperatures = []
node_numbers = []
node_centres = []


# Function to find the centroid of a polygon (used for the node labels)
def polygon_centroid(pts):

    x = np.array([p[0] for p in pts])
    y = np.array([p[1] for p in pts])
    x2 = np.roll(x, -1)
    y2 = np.roll(y, -1)

    cross = x*y2 - x2*y
    area = cross.sum()/2

    cx = ((x + x2)*cross).sum()/(6*area)
    cy = ((y + y2)*cross).sum()/(6*area)

    return (cx, cy)


# Function to create any thermal node from a list of corner points
def add_poly(node, pts):

    polygons.append(pts)

    temperatures.append(T[node])

    node_numbers.append(node)

    node_centres.append(polygon_centroid(pts))


# Function to create rectangular thermal nodes
def add_node(node, x1, x2, y1, y2):

    add_poly(node, [
        (x1, y1),
        (x2, y1),
        (x2, y2),
        (x1, y2)
    ])


# ============================================================
# FILLET GEOMETRY
# ============================================================

x_cl = w/2 - r        # x where the fillet arcs meet the flat floor / ceiling

# column edges (x): A = channel centre side, D = rib centre
xA, xB, xC, xD, xE = 0, w1, 2*w1, w/2 + w_r/4, w/2 + w_r/2

# floor surface height as a function of x (flat, then fillet arc up to the rib)
def floor_y(x):
    dx = np.maximum(x - x_cl, 0)
    return t + r - np.sqrt(np.maximum(r**2 - dx**2, 0))

# ceiling surface height as a function of x (flat, then fillet arc down to the rib)
def ceil_y(x):
    dx = np.maximum(x - x_cl, 0)
    return t + h - r + np.sqrt(np.maximum(r**2 - dx**2, 0))

# rib face position as a function of y (lower arc, flat face, upper arc)
def rib_x(y):
    dy = np.where(y < t + r, y - (t + r),
         np.where(y > t + h - r, y - (t + h - r), 0))
    return x_cl + np.sqrt(np.maximum(r**2 - dy**2, 0))

# node whose top edge follows the floor fillet (nodes 12, 13)
def add_floor_node(node, xa, xb):
    pts = [(xa, 3*t1), (xb, 3*t1)]
    pts += [(x, floor_y(x)) for x in np.linspace(xb, xa, 20)]
    add_poly(node, pts)

# node whose bottom edge follows the ceiling fillet (nodes 18, 19)
def add_ceiling_node(node, xa, xb):
    y_top = t + h + o_t1
    pts = [(xa, y_top), (xb, y_top)]
    pts += [(x, ceil_y(x)) for x in np.linspace(xb, xa, 20)]
    add_poly(node, pts)

# node whose left edge follows the rib fillet (nodes 14 to 17)
def add_rib_fillet_node(node, y1, y2):
    pts = [(xD, y1), (xD, y2)]
    pts += [(rib_x(y), y) for y in np.linspace(y2, y1, 20)]
    add_poly(node, pts)


