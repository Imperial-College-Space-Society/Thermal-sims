def fillet_hight(x): 
    if x <= r-radial_extention:
        return r - np.sqrt(r**2-(r-radial_extention-x)**2)  #hight added by the fillet as a function of distance away from the corner segment
    elif x > r-radial_extention:
        return 0

def fillet_length(x):  #length of fillet segment arcs 
    if r == 0:
        return 0.0
    return r*(np.arcsin((r-radial_extention)/r)-np.arcsin((r-radial_extention-x)/r))

def fillet_area(x):  #Area of fillet segments 
    if r == 0:
        return 0.0
    return r*x - (r-radial_extention)/2 * np.sqrt(r**2-(r-radial_extention)**2) + (r-radial_extention-x)/2 * np.sqrt(r**2-(r-radial_extention-x)**2) - (r**2)/2 * (np.arcsin((r-radial_extention)/r)-np.arcsin((r-radial_extention-x)/r))


#calculating areas and volumes of segments adjacent to coolant channel
